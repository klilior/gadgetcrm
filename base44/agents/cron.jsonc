{
  "name": "cron",
  "description": "\u05e1\u05d5\u05db\u05df \u05d6\u05d4 \u05de\u05e0\u05d4\u05dc \u05d0\u05ea \u05db\u05dc \u05d4\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d4\u05de\u05ea\u05d6\u05d5\u05de\u05e0\u05d5\u05ea \u05d1\u05de\u05e2\u05e8\u05db\u05ea (Cron Jobs).",
  "instructions": "\u05d0\u05d9\u05df \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05e1\u05d5\u05db\u05df \u05d6\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05d3\u05e0\u05d9.",
  "schedules": [
    {
      "function_name": "forceProcessReminders",
      "schedule": "* * * * *",
      "description": "\u05d1\u05d5\u05d3\u05e7 \u05d1\u05db\u05dc \u05d3\u05e7\u05d4 \u05d0\u05dd \u05d9\u05e9 \u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05dc\u05e9\u05dc\u05d5\u05d7 \u05dc\u05e0\u05e6\u05d9\u05d2\u05d9\u05dd."
    },
    {
      "function_name": "autoCloseTickets",
      "schedule": "0 2 * * *",
      "description": "\u05e1\u05d5\u05d2\u05e8 \u05d8\u05d9\u05e7\u05d8\u05d9\u05dd \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05d0\u05d7\u05e8\u05d9 14 \u05d9\u05d5\u05dd \u05dc\u05dc\u05d0 \u05de\u05e2\u05e0\u05d4 - \u05e8\u05e5 \u05db\u05dc \u05d9\u05d5\u05dd \u05d1-02:00"
    },
    {
      "function_name": "syncWooProducts",
      "schedule": "0 2 * * *",
      "description": "\u05de\u05e1\u05e0\u05db\u05e8\u05df \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05de-WooCommerce - \u05e8\u05e5 \u05db\u05dc \u05d9\u05d5\u05dd \u05d1-02:00"
    },
    {
      "function_name": "linetHourlySync",
      "schedule": "0 9-22 * * *",
      "description": "\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05e9\u05e2\u05ea\u05d9 \u05de\u05dc\u05d9\u05e0\u05d8 - \u05db\u05dc \u05e9\u05e2\u05d4 \u05d1\u05d9\u05df 09:00 \u05dc-22:00 (\u05e9\u05e2\u05d5\u05df \u05d9\u05e9\u05e8\u05d0\u05dc)"
    },
    {
      "function_name": "linetNightlySync",
      "schedule": "30 2 * * *",
      "description": "\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05dc\u05d9\u05dc\u05d4 \u05e2\u05de\u05d5\u05e7 \u05de\u05dc\u05d9\u05e0\u05d8 - \u05db\u05dc \u05dc\u05d9\u05dc\u05d4 \u05d1-02:30 (\u05d9\u05d9\u05e9\u05d5\u05e8 \u05e7\u05d5 3 \u05d9\u05de\u05d9\u05dd)"
    }
  ]
}