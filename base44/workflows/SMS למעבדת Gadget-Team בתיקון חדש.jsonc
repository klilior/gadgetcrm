{
  "name": "SMS \u05dc\u05de\u05e2\u05d1\u05d3\u05ea Gadget-Team \u05d1\u05ea\u05d9\u05e7\u05d5\u05df \u05d7\u05d3\u05e9",
  "description": "\u05e9\u05d5\u05dc\u05d7 SMS \u05dc\u05d1\u05e2\u05dc \u05de\u05e2\u05d1\u05d3\u05ea Gadget-Team \u05db\u05e9\u05e0\u05e4\u05ea\u05d7 \u05ea\u05d9\u05e7\u05d5\u05df \u05d7\u05d3\u05e9 \u05de\u05e1\u05d5\u05d2 \u05de\u05e2\u05d1\u05d3\u05ea Gadget-Team",
  "trigger": {
    "condition": "${ (.trigger.data.repair_type == \"\\u05de\\u05e2\\u05d1\\u05d3\\u05ea Gadget-Team\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Repair"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sms_gadget_team",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyGadgetTeamRepair",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyGadgetTeamRepair"
  }
}