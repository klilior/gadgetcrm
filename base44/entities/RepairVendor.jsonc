{
  "name": "RepairVendor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d9\u05d1\u05d5\u05d0\u05df/\u05de\u05e2\u05d1\u05d3\u05d4",
      "index": true
    },
    "mobile": {
      "type": "string",
      "description": "\u05e0\u05d9\u05d9\u05d3 \u05e8\u05d0\u05e9\u05d9"
    },
    "additional_phones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05e1\u05e4\u05e8\u05d9 \u05d8\u05dc\u05e4\u05d5\u05df \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05dc\u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u05e4\u05e2\u05d9\u05dc"
    },
    "canonical_supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 Supplier \u05e7\u05e0\u05d5\u05e0\u05d9 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05e8\u05e9\u05d5\u05de\u05d4 \u05d6\u05d5 \u05de\u05de\u05d5\u05e4\u05d4. \u05d0\u05d3\u05d9\u05d8\u05d9\u05d1\u05d9 \u05d1\u05dc\u05d1\u05d3, \u05d0\u05d9\u05df \u05de\u05d7\u05d9\u05e7\u05d4",
      "index": true
    },
    "canonical_link_method": {
      "type": "string",
      "enum": [
        "manual",
        "vat_id",
        "exact_normalized_name",
        "verified_alias",
        "unresolved",
        "MANUAL_VERIFIED"
      ],
      "description": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05e7\u05d1\u05e2 \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e1\u05e4\u05e7 \u05d4\u05e7\u05e0\u05d5\u05e0\u05d9. MANUAL_VERIFIED = \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d0\u05e0\u05d5\u05e9\u05d9 \u05de\u05e4\u05d5\u05e8\u05e9 \u05e2\u05dc \u05d1\u05e1\u05d9\u05e1 \u05e8\u05d0\u05d9\u05d5\u05ea \u05de\u05ea\u05d5\u05e2\u05d3\u05d5\u05ea"
    },
    "canonical_link_confidence": {
      "type": "string",
      "enum": [
        "certain",
        "strong",
        "weak",
        "ambiguous",
        "HIGH"
      ],
      "description": "\u05e8\u05de\u05ea \u05d5\u05d3\u05d0\u05d5\u05ea \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8. merge \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e8\u05e7 \u05d1-certain; HIGH = \u05d0\u05d5\u05e9\u05e8 \u05d9\u05d3\u05e0\u05d9\u05ea"
    },
    "canonical_link_evidence_summary": {
      "type": "string",
      "description": "\u05e1\u05d9\u05db\u05d5\u05dd \u05d4\u05e8\u05d0\u05d9\u05d5\u05ea \u05e9\u05e2\u05dc \u05d1\u05e1\u05d9\u05e1\u05df \u05d0\u05d5\u05e9\u05e8 \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8"
    },
    "canonical_link_approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d0\u05e0\u05d5\u05e9\u05d9 \u05dc\u05e7\u05d9\u05e9\u05d5\u05e8"
    },
    "canonical_link_migration_run_id": {
      "type": "string",
      "description": "MigrationRun \u05e9\u05d1\u05de\u05e1\u05d2\u05e8\u05ea\u05d5 \u05e0\u05db\u05ea\u05d1 \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8",
      "index": true
    },
    "canonical_link_correlation_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e2\u05e7\u05d1 \u05dc\u05d6\u05e8\u05d9\u05de\u05ea \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8",
      "index": true
    },
    "canonical_linked_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e1\u05e4\u05e7 \u05d4\u05e7\u05e0\u05d5\u05e0\u05d9"
    }
  },
  "required": [
    "name",
    "mobile"
  ]
}