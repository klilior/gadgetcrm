{
  "name": "OrderSerialLine",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d4\u05d6\u05de\u05e0\u05d4",
      "index": true
    },
    "order_item_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05d5\u05e8\u05ea \u05d4\u05de\u05d5\u05e6\u05e8 \u05d1\u05d4\u05d6\u05de\u05e0\u05d4 \u2014 \u05d4\u05de\u05e4\u05ea\u05d7 \u05d4\u05dc\u05d5\u05d2\u05d9. \u05e1\u05e8\u05d9\u05d0\u05dc\u05d9 \u05e0\u05e9\u05de\u05e8 \u05ea\u05de\u05d9\u05d3 \u05d1\u05e8\u05de\u05ea \u05e9\u05d5\u05e8\u05d4, \u05dc\u05d0 \u05d1\u05e8\u05de\u05ea \u05d4\u05d6\u05de\u05e0\u05d4",
      "index": true
    },
    "source": {
      "type": "string",
      "enum": [
        "woo",
        "superpharm",
        "manual"
      ],
      "description": "\u05de\u05e7\u05d5\u05e8 \u05e9\u05d5\u05e8\u05ea \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "source_sku": {
      "type": "string",
      "description": "\u05de\u05e7\"\u05d8 \u05d4\u05de\u05e7\u05d5\u05e8 \u05db\u05e4\u05d9 \u05e9\u05d4\u05d2\u05d9\u05e2 \u05de\u05d4\u05de\u05e8\u05e7\u05d8\u05e4\u05dc\u05d9\u05d9\u05e1/\u05d0\u05ea\u05e8"
    },
    "source_product_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05de\u05d4\u05de\u05e7\u05d5\u05e8"
    },
    "mapped_linet_item_id": {
      "type": "number",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e4\u05e8\u05d9\u05d8 \u05d4\u05de\u05de\u05d5\u05e4\u05d4 \u05d1-Linet (nullable)"
    },
    "mapped_linet_sku": {
      "type": "string",
      "description": "\u05de\u05e7\"\u05d8 \u05d4\u05e4\u05e8\u05d9\u05d8 \u05d4\u05de\u05de\u05d5\u05e4\u05d4 \u05d1-Linet (nullable)"
    },
    "mapped_linet_item_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d9\u05d8 \u05d4\u05de\u05de\u05d5\u05e4\u05d4 \u05d1-Linet (nullable)"
    },
    "requires_serial": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e9\u05d5\u05e8\u05d4 \u05d6\u05d5 \u05d3\u05d5\u05e8\u05e9\u05ea \u05de\u05e1\u05e4\u05e8 \u05e1\u05d9\u05d3\u05d5\u05e8\u05d9"
    },
    "serials_required_count": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05e1\u05e8\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u2014 \u05e9\u05d5\u05d5\u05d4 \u05dc\u05db\u05de\u05d5\u05ea \u05e9\u05e0\u05e8\u05db\u05e9\u05d4 \u05d1\u05e9\u05d5\u05e8\u05d4"
    },
    "assigned_serials": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05e2\u05e8\u05da \u05d4\u05de\u05e1\u05e4\u05e8\u05d9\u05dd \u05d4\u05e1\u05d9\u05d3\u05d5\u05e8\u05d9\u05d9\u05dd (idcode) \u05e9\u05e0\u05d1\u05d7\u05e8\u05d5/\u05d4\u05d5\u05e7\u05e6\u05d5 \u05dc\u05e9\u05d5\u05e8\u05d4 \u05d6\u05d5"
    },
    "serial_status": {
      "type": "string",
      "enum": [
        "not_required",
        "required_missing",
        "selected",
        "verified",
        "invoiced"
      ],
      "default": "not_required",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05e8\u05d9\u05d0\u05dc\u05d9 \u05dc\u05e9\u05d5\u05e8\u05d4 \u05d6\u05d5"
    },
    "serial_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d0\u05d5\u05de\u05ea\u05d5 \u05d4\u05e1\u05e8\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd (nullable)"
    },
    "serial_verified_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05d0\u05d9\u05de\u05ea \u05d0\u05ea \u05d4\u05e1\u05e8\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd (nullable)"
    }
  },
  "required": [
    "order_id",
    "order_item_id"
  ]
}