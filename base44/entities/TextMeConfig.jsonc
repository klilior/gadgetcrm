{
  "name": "TextMeConfig",
  "type": "object",
  "properties": {
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u05e9\u05d9\u05e8\u05d5\u05ea SMS \u05e4\u05e2\u05d9\u05dc"
    },
    "username": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05ea\u05de\u05e9 \u05d1-TextMe"
    },
    "default_source": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e9\u05d5\u05dc\u05d7 \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc (\u05e2\u05d3 11 \u05ea\u05d5\u05d5\u05d9\u05dd, \u05d0\u05e0\u05d2\u05dc\u05d9\u05ea/\u05de\u05e1\u05e4\u05e8\u05d9\u05dd)"
    },
    "test_mode": {
      "type": "boolean",
      "default": false,
      "description": "\u05de\u05e6\u05d1 \u05d1\u05d3\u05d9\u05e7\u05d4 (\u05e9\u05dc\u05d9\u05d7\u05d4 \u05dc-API test)"
    },
    "rate_limit_per_minute": {
      "type": "number",
      "default": 10,
      "description": "\u05de\u05d2\u05d1\u05dc\u05ea \u05e9\u05dc\u05d9\u05d7\u05d5\u05ea \u05dc\u05d3\u05e7\u05d4"
    },
    "allowed_hours_start": {
      "type": "string",
      "default": "08:00",
      "description": "\u05e9\u05e2\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4 \u05de\u05d5\u05ea\u05e8\u05ea \u05dc\u05e9\u05dc\u05d9\u05d7\u05d4"
    },
    "allowed_hours_end": {
      "type": "string",
      "default": "22:00",
      "description": "\u05e9\u05e2\u05ea \u05e1\u05d9\u05d5\u05dd \u05de\u05d5\u05ea\u05e8\u05ea \u05dc\u05e9\u05dc\u05d9\u05d7\u05d4"
    },
    "admin_phones": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05e0\u05d9\u05dd \u05dc\u05e7\u05d1\u05dc\u05ea \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea (\u05de\u05d5\u05e4\u05e8\u05d3\u05d9\u05dd \u05d1\u05e4\u05e1\u05d9\u05e7)"
    }
  },
  "required": [
    "username",
    "default_source"
  ]
}