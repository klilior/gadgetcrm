{
  "name": "Suppliers",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e1\u05e4\u05e7"
    },
    "vat_id": {
      "type": "string",
      "description": "\u05d7.\u05e4/\u05e2\u05d5\u05e1\u05e7",
      "index": true,
      "unique": true
    },
    "aliases": {
      "type": "string",
      "description": "\u05db\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9"
    },
    "created_from_invoice": {
      "type": "boolean",
      "default": false,
      "description": "\u05e0\u05d5\u05e6\u05e8 \u05de\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05e4\u05e2\u05d9\u05dc"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d5\u05e6\u05d0\u05d4 \u05e7\u05d1\u05d5\u05e2\u05d4"
    },
    "is_recurring_expense": {
      "type": "boolean",
      "default": false,
      "description": "\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05dc\u05e1\u05d9\u05de\u05d5\u05df \u05d4\u05d5\u05e6\u05d0\u05d4 \u05e7\u05d1\u05d5\u05e2\u05d4"
    },
    "recurring_type": {
      "type": "string",
      "enum": [
        "\u05e9\u05db\"\u05d3",
        "\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea",
        "\u05de\u05e0\u05d5\u05d9",
        "\u05e9\u05d9\u05e8\u05d5\u05ea \u05e7\u05d1\u05d5\u05e2",
        "\u05d0\u05d7\u05e8"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d5\u05e6\u05d0\u05d4 \u05e7\u05d1\u05d5\u05e2\u05d4"
    },
    "expected_invoices_per_month": {
      "type": "number",
      "default": 1,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05d5\u05ea \u05e6\u05e4\u05d5\u05d9 \u05d1\u05d7\u05d5\u05d3\u05e9"
    },
    "supplier_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05e1\u05e4\u05e7 \u05e7\u05d9\u05d9\u05dd"
    },
    "default_expense_category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d5\u05e6\u05d0\u05d4 \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc"
    },
    "include_in_goods_ratio": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05db\u05dc\u05dc \u05d1\u05d9\u05d7\u05e1 \u05d4\u05e1\u05d7\u05d5\u05e8\u05d4"
    },
    "learned_classification": {
      "type": "string",
      "enum": [
        "fixed",
        "goods"
      ],
      "description": "\u05e1\u05d9\u05d5\u05d5\u05d2 \u05d9\u05d3\u05e0\u05d9 \u05e9\u05e0\u05dc\u05de\u05d3 \u05dc\u05e1\u05e4\u05e7"
    },
    "classification_learned_from_invoice": {
      "type": "string",
      "description": "\u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05e9\u05de\u05de\u05e0\u05d4 \u05e0\u05dc\u05de\u05d3 \u05d4\u05e1\u05d9\u05d5\u05d5\u05d2"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": []
}