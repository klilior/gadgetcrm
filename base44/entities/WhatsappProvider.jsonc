{
  "name": "WhatsappProvider",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e1\u05e4\u05e7 (Green API, Bot.it, \u05d5\u05db\u05d5')"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "green-api",
        "botit",
        "ultramsg"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e1\u05e4\u05e7"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e1\u05e4\u05e7 \u05e4\u05e2\u05d9\u05dc"
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "description": "\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05e1\u05e4\u05e7 (API keys, endpoints, \u05d5\u05db\u05d5')"
    },
    "webhook_url": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05d5\u05d5\u05d1\u05d4\u05d5\u05e7 \u05dc\u05e7\u05d1\u05dc\u05ea \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea"
    },
    "phone_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d8\u05dc\u05e4\u05d5\u05df \u05d4\u05de\u05e9\u05d5\u05d9\u05da"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d5\u05d4\u05e1\u05d1\u05e8\u05d9\u05dd"
    }
  },
  "required": [
    "name",
    "provider_type",
    "config"
  ]
}