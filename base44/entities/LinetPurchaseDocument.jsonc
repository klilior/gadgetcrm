{
  "name": "LinetPurchaseDocument",
  "type": "object",
  "properties": {
    "linet_doc_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e1\u05de\u05da \u05e8\u05db\u05e9 \u05d1\u05dc\u05d9\u05e0\u05d8",
      "index": true,
      "unique": true
    },
    "linet_doc_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e1\u05de\u05da \u05e4\u05e0\u05d9\u05de\u05d9 \u05d1\u05dc\u05d9\u05e0\u05d8"
    },
    "supplier_invoice_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05e1\u05e4\u05e7 \u05de-refnum_ext"
    },
    "normalized_invoice_number": {
      "type": "string",
      "description": "\u05d4\u05dc\u05d9\u05d1\u05d4 \u05d4\u05de\u05e1\u05e4\u05e8\u05d9\u05ea \u05d4\u05de\u05e0\u05d5\u05e8\u05de\u05dc\u05ea",
      "index": true
    },
    "doc_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05d4\u05e1\u05e4\u05e7",
      "index": true
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e6\u05d9\u05e8\u05ea \u05de\u05e1\u05de\u05da \u05d4\u05e8\u05db\u05e9 \u05d1\u05dc\u05d9\u05e0\u05d8"
    },
    "supplier_account_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d7\u05e9\u05d1\u05d5\u05df \u05e1\u05e4\u05e7 \u05d1\u05dc\u05d9\u05e0\u05d8",
      "index": true
    },
    "supplier_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e1\u05e4\u05e7 \u05d1\u05dc\u05d9\u05e0\u05d8"
    },
    "supplier_vat_id": {
      "type": "string",
      "description": "\u05d7.\u05e4. \u05d4\u05e1\u05e4\u05e7"
    },
    "subtotal_before_vat": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05dc\u05e4\u05e0\u05d9 \u05de\u05e2\u05de"
    },
    "vat_amount": {
      "type": "number",
      "description": "\u05de\u05e2\u05de"
    },
    "total_with_vat": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05db\u05d5\u05dc\u05dc \u05de\u05e2\u05de"
    },
    "line_total_with_vat": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05e9\u05d5\u05e8\u05d5\u05ea \u05db\u05d5\u05dc\u05dc \u05de\u05e2\u05de"
    },
    "lines_json": {
      "type": "string",
      "description": "\u05e9\u05d5\u05e8\u05d5\u05ea \u05de\u05e1\u05de\u05da 13 \u05dc\u05e6\u05d5\u05e8\u05da \u05d4\u05e6\u05dc\u05d1\u05d4"
    },
    "matched_invoice_id": {
      "type": "string",
      "description": "\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05ea\u05d5\u05d0\u05de\u05ea \u05d1\u05de\u05e2\u05e8\u05db\u05ea",
      "index": true
    },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "unmatched",
        "matched",
        "ambiguous"
      ],
      "default": "unmatched",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e6\u05dc\u05d1\u05d4",
      "index": true
    },
    "match_reason": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d1\u05e8 \u05d4\u05ea\u05d0\u05de\u05d4"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d0\u05d7\u05e8\u05d5\u05df"
    }
  },
  "required": [
    "linet_doc_id",
    "linet_doc_number"
  ]
}