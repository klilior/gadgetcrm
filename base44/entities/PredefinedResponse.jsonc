{
  "name": "PredefinedResponse",
  "type": "object",
  "properties": {
    "response_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05ea\u05e9\u05d5\u05d1\u05d4"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "whatsapp",
          "email",
          "phone"
        ]
      },
      "description": "\u05e2\u05e8\u05d5\u05e6\u05d9\u05dd"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "response_name",
    "content"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc",
            "\u05e0\u05e6\u05d9\u05d2"
          ]
        }
      }
    },
    "write": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}