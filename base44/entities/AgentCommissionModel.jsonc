{
  "name": "AgentCommissionModel",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e0\u05e6\u05d9\u05d2 (User ID)",
      "index": true
    },
    "agent_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e0\u05e6\u05d9\u05d2 (\u05dc\u05e0\u05d5\u05d7\u05d5\u05ea)"
    },
    "commission_model_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05d3\u05dc \u05d4\u05e2\u05de\u05dc\u05d5\u05ea"
    },
    "valid_from": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05d7\u05d9\u05dc\u05ea \u05ea\u05d5\u05e7\u05e3"
    },
    "valid_to": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05ea\u05d5\u05e7\u05e3 (\u05e8\u05d9\u05e7 = \u05e4\u05ea\u05d5\u05d7)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e9\u05d9\u05d5\u05da \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "agent_id",
    "commission_model_id"
  ]
}