{
  "name": "ContractNote",
  "type": "object",
  "properties": {
    "line_contract_id": {
      "type": "string",
      "description": "LineContract reference",
      "index": true
    },
    "agent_id": {
      "type": "string",
      "description": "Agent who created the note",
      "index": true
    },
    "agent_name": {
      "type": "string",
      "description": "Agent name (cached)"
    },
    "note_text": {
      "type": "string",
      "description": "Note content"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "CALL",
        "FOLLOWUP",
        "REMINDER",
        "OTHER"
      ],
      "default": "OTHER",
      "description": "Type of note"
    }
  },
  "required": [
    "line_contract_id",
    "agent_id",
    "note_text"
  ]
}