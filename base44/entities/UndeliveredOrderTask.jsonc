{
  "name": "UndeliveredOrderTask",
  "type": "object",
  "properties": {
    "source_system": {
      "type": "string",
      "default": "Linet",
      "description": "\u05de\u05e2\u05e8\u05db\u05ea \u05de\u05e7\u05d5\u05e8"
    },
    "source_doc_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e1\u05de\u05da \u05de\u05e7\u05d5\u05e8 (\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9)",
      "index": true,
      "unique": true
    },
    "source_doc_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e1\u05de\u05da",
      "index": true
    },
    "source_doc_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05de\u05e1\u05de\u05da"
    },
    "owner_user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e0\u05e6\u05d9\u05d2 (\u05d1\u05e2\u05dc\u05d9\u05dd)",
      "index": true
    },
    "owner_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e0\u05e6\u05d9\u05d2"
    },
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05dc\u05e7\u05d5\u05d7"
    },
    "customer_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05e7\u05d5\u05d7"
    },
    "products_list": {
      "type": "string",
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05d5\u05e6\u05e8\u05d9\u05dd (JSON)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Closed"
      ],
      "default": "Open",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05de\u05e9\u05d9\u05de\u05d4",
      "index": true
    },
    "close_reason": {
      "type": "string",
      "enum": [
        "Cargo",
        "UPS",
        "Pickup",
        "Cancelled"
      ],
      "description": "\u05e1\u05d9\u05d1\u05ea \u05e1\u05d2\u05d9\u05e8\u05d4"
    },
    "close_note": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05ea \u05e1\u05d2\u05d9\u05e8\u05d4"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d2\u05d9\u05e8\u05d4"
    },
    "activity_log": {
      "type": "string",
      "description": "\u05dc\u05d5\u05d2 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea (JSON)"
    }
  },
  "required": [
    "source_doc_id",
    "source_doc_number",
    "owner_user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "\u05de\u05e0\u05d4\u05dc",
                "\u05e0\u05e6\u05d9\u05d2",
                "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "\u05de\u05e0\u05d4\u05dc",
                "\u05e0\u05e6\u05d9\u05d2",
                "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "\u05de\u05e0\u05d4\u05dc",
                "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}