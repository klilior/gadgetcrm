{
  "name": "OvertimeRule",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "org",
        "site"
      ],
      "default": "org",
      "description": "\u05d4\u05d9\u05e7\u05e3 \u05d4\u05d7\u05d5\u05e7"
    },
    "site_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d0\u05ea\u05e8 (\u05d0\u05dd scope=site)"
    },
    "daily_regular_minutes": {
      "type": "integer",
      "default": 480,
      "description": "\u05d3\u05e7\u05d5\u05ea \u05e8\u05d2\u05d9\u05dc\u05d5\u05ea \u05d1\u05d9\u05d5\u05dd (8 \u05e9\u05e2\u05d5\u05ea)"
    },
    "daily_first_tier_minutes": {
      "type": "integer",
      "default": 120,
      "description": "\u05d3\u05e7\u05d5\u05ea \u05e9\u05db\u05d1\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 (2 \u05e9\u05e2\u05d5\u05ea)"
    },
    "first_tier_multiplier": {
      "type": "number",
      "default": 1.25,
      "description": "\u05de\u05db\u05e4\u05d9\u05dc \u05e9\u05db\u05d1\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4"
    },
    "second_tier_multiplier": {
      "type": "number",
      "default": 1.5,
      "description": "\u05de\u05db\u05e4\u05d9\u05dc \u05e9\u05db\u05d1\u05d4 \u05e9\u05e0\u05d9\u05d9\u05d4"
    },
    "weekly_regular_minutes": {
      "type": "integer",
      "default": 2520,
      "description": "\u05d3\u05e7\u05d5\u05ea \u05e8\u05d2\u05d9\u05dc\u05d5\u05ea \u05d1\u05e9\u05d1\u05d5\u05e2 (42 \u05e9\u05e2\u05d5\u05ea)"
    },
    "unpaid_break_after_minutes": {
      "type": "integer",
      "default": 360,
      "description": "\u05d4\u05e4\u05e1\u05e7\u05d4 \u05dc\u05d0 \u05d1\u05ea\u05e9\u05dc\u05d5\u05dd \u05d0\u05d7\u05e8\u05d9 \u05d3\u05e7\u05d5\u05ea (6 \u05e9\u05e2\u05d5\u05ea)"
    },
    "unpaid_break_length": {
      "type": "integer",
      "default": 30,
      "description": "\u05d0\u05d5\u05e8\u05da \u05d4\u05e4\u05e1\u05e7\u05d4 \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "effective_from": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05e7\u05e3 \u05d4\u05d7\u05dc \u05de\u05ea\u05d0\u05e8\u05d9\u05da"
    }
  },
  "required": [
    "scope",
    "effective_from"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc",
            "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}