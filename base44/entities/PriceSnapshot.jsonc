    },
    "gap_to_first_place": {
      "type": "number",
      "description": "\u05e4\u05e2\u05e8 \u05de\u05de\u05e7\u05d5\u05dd 1 (\u20aa)"
    },
    "prev_snapshot": {
      "type": "string",
      "description": "\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e7\u05d5\u05d3\u05de\u05ea (\u05de\u05d6\u05d4\u05d4)",
