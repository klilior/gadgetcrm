    "below_price_delta": {
      "type": "number",
      "description": "\u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d7\u05d9\u05e8 \u05de\u05ea\u05d7\u05e8\u05d4 \u05de\u05ea\u05d7\u05ea (\u20aa)"
    },
    "debug_wc_source": {
      "type": "string",
      "description": "\u05d3\u05d9\u05d1\u05d0\u05d2: \u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d9\u05ea \u05de\u05d7\u05d9\u05e8 WC"
    },
    "debug_wc_candidates": {
      "type": "string",
      "description": "\u05d3\u05d9\u05d1\u05d0\u05d2: \u05de\u05d5\u05e2\u05de\u05d3\u05d9 \u05de\u05d7\u05d9\u05e8 WC (JSON)"
    },
    "debug_wc_html_sample": {
      "type": "string",
      "description": "\u05d3\u05d9\u05d1\u05d0\u05d2: \u05d3\u05d5\u05d2\u05de\u05ea HTML"
    },
    "debug_zap_found_store_name": {
      "type": "string",
      "description": "\u05d3\u05d9\u05d1\u05d0\u05d2: \u05e9\u05dd \u05d7\u05e0\u05d5\u05ea \u05e9\u05e0\u05de\u05e6\u05d0 \u05d1\u05d6\u05d0\u05e4"
    },
    "debug_zap_my_price": {
      "type": "number",
      "description": "\u05d3\u05d9\u05d1\u05d0\u05d2: \u05de\u05d7\u05d9\u05e8 \u05e9\u05dc\u05e0\u05d5 \u05d1\u05d6\u05d0\u05e4"
    },
    "debug_zap_top5": {
      "type": "string",
      "description": "\u05d3\u05d9\u05d1\u05d0\u05d2: Top 5 \u05d7\u05e0\u05d5\u05d9\u05d5\u05ea \u05d1\u05d6\u05d0\u05e4 (JSON)"
    }
  },
  "required": [
    "linked_product",
    "check_timestamp"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc",
            "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}