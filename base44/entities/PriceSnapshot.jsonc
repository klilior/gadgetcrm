    },
    "position_below_me_price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05de\u05e7\u05d5\u05dd \u05de\u05ea\u05d7\u05ea\u05d9\u05e0\u05d5 (\u20aa)"
