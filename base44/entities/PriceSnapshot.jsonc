    "price_zap_delta": {
      "type": "number",
      "description": "\u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d7\u05d9\u05e8 \u05d1\u05d6\u05d0\u05e4 (\u20aa)"
    },
    "above_price_delta": {
      "type": "number",
      "description": "\u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d7\u05d9\u05e8 \u05de\u05ea\u05d7\u05e8\u05d4 \u05de\u05e2\u05dc (\u20aa)"
