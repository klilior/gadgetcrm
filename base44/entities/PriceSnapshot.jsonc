{
  "name": "PriceSnapshot",
  "type": "object",
  "properties": {
    "linked_product": {
      "type": "string",
      "description": "\u05de\u05d5\u05e6\u05e8 \u05de\u05e7\u05d5\u05e9\u05e8",
      "index": true
    },
    "check_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d1\u05d3\u05d9\u05e7\u05d4"
    },
    "my_position": {
      "type": "number",
      "description": "\u05d4\u05de\u05d9\u05e7\u05d5\u05dd \u05e9\u05dc\u05e0\u05d5"
    },
    "my_price_on_site": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05e9\u05dc\u05e0\u05d5 \u05d1\u05d0\u05ea\u05e8 (\u20aa)"
    },
    "my_price_on_zap": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05e9\u05dc\u05e0\u05d5 \u05d1-Zap (\u20aa)"
    },
