{
  "name": "Lead",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df",
      "index": true
    },
    "topic": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05e4\u05e0\u05d9\u05d9\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "assigned_to": {
      "type": "string",
      "description": "\u05de\u05d5\u05e7\u05e6\u05d4 \u05dc\u05e0\u05e6\u05d9\u05d2",
      "index": true
    },
    "assigned_to_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e0\u05e6\u05d9\u05d2 \u05d4\u05de\u05d5\u05e7\u05e6\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "InProgress",
        "Closed",
        "Deleted"
      ],
      "default": "New",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "index": true
    },
    "reminder_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05d1\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "reminder_done": {
      "type": "boolean",
      "default": false,
      "description": "\u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05d1\u05d5\u05e6\u05e2\u05d4"
    },
    "sla_due_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d9\u05e2\u05d3 SLA"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05e0\u05de\u05d7\u05e7 \u05d1\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "capture_type": {
      "type": "string",
      "enum": [
        "Quick",
        "Full"
      ],
      "default": "Full",
      "description": "\u05e1\u05d5\u05d2 \u05e7\u05dc\u05d9\u05d8\u05d4"
    },
    "quick_incomplete": {
      "type": "boolean",
      "default": false,
      "description": "\u05dc\u05d9\u05d3 \u05de\u05d4\u05d9\u05e8 \u05dc\u05d0 \u05d4\u05d5\u05e9\u05dc\u05dd"
    }
  },
  "required": [
    "phone",
    "topic",
    "assigned_to"
  ]
}