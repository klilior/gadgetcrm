      "type": "string",
      "format": "date-time",
      "description": "\u05e0\u05e1\u05d2\u05e8 \u05d1\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "sla_plan": {
      "type": "string",
      "enum": [
        "\u05e9\u05d9\u05e8\u05d5\u05ea",
        "\u05ea\u05dc\u05d5\u05e0\u05d4",
