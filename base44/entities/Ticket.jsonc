      "type": "string",
      "enum": [
        "\u05e9\u05d9\u05dc\u05d5\u05d7",
        "\u05ea\u05de\u05d9\u05db\u05d4 \u05d1\u05de\u05d5\u05e6\u05e8",
        "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d6\u05de\u05e0\u05d4",
        "\u05ea\u05dc\u05d5\u05e0\u05d4",
        "\u05d7\u05e7\u05d9\u05e8\u05ea \u05de\u05db\u05d9\u05e8\u05d4",
        "\u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05e7\u05d5\u05d7\u05d5\u05ea",
        "\u05e9\u05d9\u05e8\u05d5\u05ea \u05ea\u05d9\u05e7\u05d5\u05e0\u05d9\u05dd \u05d1\u05de\u05e2\u05d1\u05d3\u05d4",
