      "description": "\u05ea\u05d5\u05db\u05e0\u05d9\u05ea SLA"
    },
    "sla_target": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d9\u05e2\u05d3 SLA"
    },
    "sla_breached": {
      "type": "boolean",
      "default": false,
      "description": "\u05d7\u05e8\u05d9\u05d2\u05ea SLA"
    },
    "customer_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05dc\u05e7\u05d5\u05d7"
    },
    "customer_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05e7\u05d5\u05d7"
    },
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05dc\u05e7\u05d5\u05d7"
    },
    "whatsapp_draft": {
      "type": "string",
      "description": "\u05d8\u05d9\u05d5\u05d8\u05ea \u05ea\u05e9\u05d5\u05d1\u05d4 \u05dc\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05d2\u05d9\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05d5\u05ea \u05d5\u05d9\u05d3\u05e0\u05d9\u05d5\u05ea"
    }
  },
  "required": [
    "subject"
  ]
