      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "assigned_to": {
      "type": "string",
      "description": "\u05de\u05d5\u05e7\u05e6\u05d4 \u05dc"
    },
    "shift": {
      "type": "string",
      "enum": [
        "\u05d1\u05d5\u05e7\u05e8",
        "\u05e2\u05e8\u05d1"
      ],
      "description": "\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "internal_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea"
    },
    "thread_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05e8\u05e9\u05d5\u05e8/\u05e9\u05d9\u05d7\u05d4"
    },
    "email_message_id": {
      "type": "string",
