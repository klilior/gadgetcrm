    },
    "customer_id": {
      "type": "string",
      "description": "\u05dc\u05e7\u05d5\u05d7"
    },
    "contact_channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "phone",
        "email",
        "in_person",
        "website"
      ],
      "description": "\u05e2\u05e8\u05d5\u05e5 \u05e4\u05e0\u05d9\u05d4"
    },
    "last_channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "phone",
        "email",
        "website"
      ],
      "description": "\u05e2\u05e8\u05d5\u05e5 \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "source": {
      "type": "string",
      "enum": [
