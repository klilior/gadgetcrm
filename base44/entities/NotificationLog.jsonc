{
  "name": "NotificationLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d0\u05d9\u05e8\u05d5\u05e2",
      "index": true
    },
    "channel": {
      "type": "string",
      "enum": [
        "SMS"
      ],
      "default": "SMS",
      "description": "\u05e2\u05e8\u05d5\u05e5"
    },
    "to_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05e0\u05de\u05e2\u05df"
    },
    "message": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "provider": {
      "type": "string",
      "enum": [
        "TextMe"
      ],
      "default": "TextMe",
      "description": "\u05e1\u05e4\u05e7"
    },
    "provider_response": {
      "type": "string",
      "description": "\u05ea\u05e9\u05d5\u05d1\u05ea \u05d4\u05e1\u05e4\u05e7"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05e0\u05e9\u05dc\u05d7",
        "\u05e0\u05db\u05e9\u05dc",
        "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d7\u05d5\u05d6\u05e8",
        "\u05e0\u05d7\u05e1\u05dd-\u05e9\u05e2\u05d5\u05ea",
        "\u05db\u05e4\u05d9\u05dc\u05d5\u05ea"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "index": true
    },
    "fingerprint": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 \u05db\u05e4\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea",
      "index": true
    },
    "linked_product": {
      "type": "string",
      "description": "\u05de\u05d5\u05e6\u05e8 \u05de\u05e7\u05d5\u05e9\u05e8",
      "index": true
    },
    "linked_alert": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e8\u05d0\u05d4 \u05de\u05e7\u05d5\u05e9\u05e8\u05ea",
      "index": true
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e9\u05dc\u05d9\u05d7\u05d4"
    }
  },
  "required": [
    "event_type",
    "to_phone",
    "message",
    "status"
  ]
}