{
  "name": "AttendanceDay",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05d5\u05d1\u05d3",
      "index": true
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da",
      "index": true
    },
    "work_minutes": {
      "type": "integer",
      "default": 0,
      "description": "\u05d3\u05e7\u05d5\u05ea \u05e2\u05d1\u05d5\u05d3\u05d4 \u05e8\u05d2\u05d9\u05dc\u05d5\u05ea"
    },
    "overtime125_minutes": {
      "type": "integer",
      "default": 0,
      "description": "\u05d3\u05e7\u05d5\u05ea \u05e9\u05e2\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea 125%"
    },
    "overtime150_minutes": {
      "type": "integer",
      "default": 0,
      "description": "\u05d3\u05e7\u05d5\u05ea \u05e9\u05e2\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea 150%"
    },
    "breaks_minutes": {
      "type": "integer",
      "default": 0,
      "description": "\u05d3\u05e7\u05d5\u05ea \u05d4\u05e4\u05e1\u05e7\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "missing_out",
        "pending_fix",
        "vacation",
        "sick"
      ],
      "default": "ok",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "first_in": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05db\u05e0\u05d9\u05e1\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4"
    },
    "last_out": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05d9\u05e6\u05d9\u05d0\u05d4 \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    },
    "calc_version": {
      "type": "integer",
      "default": 1,
      "description": "\u05d2\u05e8\u05e1\u05ea \u05d7\u05d9\u05e9\u05d5\u05d1"
    }
  },
  "required": [
    "user_id",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "\u05de\u05e0\u05d4\u05dc",
                "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "\u05de\u05e0\u05d4\u05dc",
                "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "\u05de\u05e0\u05d4\u05dc",
                "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}