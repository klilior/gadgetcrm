{
  "name": "InvoiceLine",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea",
      "index": true
    },
    "line_number": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e9\u05d5\u05e8\u05d4 (\u05de\u05e4\u05ea\u05d7 \u05d9\u05e6\u05d9\u05d1 \u05d9\u05d7\u05d3 \u05e2\u05dd invoice_id)"
    },
    "sku": {
      "type": "string",
      "description": "\u05de\u05e7\u05f4\u05d8",
      "index": true
    },
    "product_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05d5\u05e6\u05e8"
    },
    "quantity": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea"
    },
    "unit_price_before_vat": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d9\u05d7\u05d9\u05d3\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05de\u05e2\u05f4\u05de"
    },
    "line_total_before_vat": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05e9\u05d5\u05e8\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05de\u05e2\u05f4\u05de"
    },
    "line_total_with_vat": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05e9\u05d5\u05e8\u05d4 \u05db\u05d5\u05dc\u05dc \u05de\u05e2\u05f4\u05de"
    },
    "supplier_id": {
      "type": "string",
      "description": "\u05e1\u05e4\u05e7",
      "index": true
    },
    "line_category": {
      "type": "string",
      "enum": [
        "fixed",
        "goods"
      ],
      "description": "\u05e1\u05d9\u05d5\u05d5\u05d2 \u05d4\u05e9\u05d5\u05e8\u05d4: \u05d4\u05d5\u05e6\u05d0\u05d4 \u05e7\u05d1\u05d5\u05e2\u05d4 \u05d0\u05d5 \u05e1\u05d7\u05d5\u05e8\u05d4",
      "index": true
    },
    "classification_source": {
      "type": "string",
      "enum": [
        "manual",
        "learned",
        "supplier_default",
        "keywords"
      ],
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05d7\u05dc\u05d8\u05ea \u05d4\u05e1\u05d9\u05d5\u05d5\u05d2"
    },
    "classification_reason": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d1\u05e8 \u05dc\u05d4\u05d7\u05dc\u05d8\u05ea \u05d4\u05e1\u05d9\u05d5\u05d5\u05d2"
    },
    "data_source": {
      "type": "string",
      "enum": [
        "extracted",
        "LINET"
      ],
      "default": "extracted",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05e2\u05e8\u05db\u05d9\u05dd \u05d4\u05e1\u05d5\u05e4\u05d9\u05d9\u05dd \u05d1\u05e9\u05d5\u05e8\u05d4: \u05d7\u05d9\u05dc\u05d5\u05e5 \u05de\u05d4\u05de\u05e1\u05de\u05da \u05d0\u05d5 \u05dc\u05d9\u05e0\u05d8"
    },
    "line_provenance_json": {
      "type": "string",
      "description": "JSON \u05e7\u05d5\u05de\u05e4\u05e7\u05d8\u05d9: \u05d4\u05e2\u05e8\u05da \u05e9\u05d7\u05d5\u05dc\u05e5 \u05de\u05d4\u05de\u05e1\u05de\u05da, \u05d4\u05e2\u05e8\u05da \u05de\u05dc\u05d9\u05e0\u05d8, \u05d4\u05de\u05e7\u05d5\u05e8 \u05e9\u05e0\u05d1\u05d7\u05e8, \u05d4\u05e1\u05d9\u05d1\u05d4, \u05d2\u05e8\u05e1\u05ea \u05d4\u05db\u05dc\u05dc \u05d5\u05d7\u05d5\u05ea\u05de\u05ea \u05d6\u05de\u05df"
    }
  },
  "required": [
    "invoice_id",
    "product_name",
    "quantity"
  ]
}