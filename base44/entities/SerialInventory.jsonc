{
  "name": "SerialInventory",
  "type": "object",
  "properties": {
    "linet_item_id": {
      "type": "number",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e4\u05e8\u05d9\u05d8 \u05d1-Linet \u2014 \u05de\u05e4\u05ea\u05d7 \u05d4\u05e1\u05d9\u05e0\u05d5\u05df",
      "index": true
    },
    "sku": {
      "type": "string",
      "description": "\u05de\u05e7\"\u05d8 \u05d4\u05e4\u05e8\u05d9\u05d8",
      "index": true
    },
    "item_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d9\u05d8"
    },
    "serial": {
      "type": "string",
      "description": "\u05d4\u05de\u05e1\u05e4\u05e8 \u05d4\u05e1\u05d9\u05d3\u05d5\u05e8\u05d9 (idcode)",
      "index": true
    },
    "warehouse_id": {
      "type": "number",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d7\u05e1\u05df (115)"
    },
    "qty": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05d1\u05de\u05dc\u05d0\u05d9"
    },
    "is_fictive": {
      "type": "boolean",
      "default": false,
      "description": "\u05e1\u05e8\u05d9\u05d0\u05dc \u05e4\u05e7\u05d8\u05d9\u05d1\u05d9 (\u05db\u05dc\u05d9 \u05ea\u05e4\u05e2\u05d5\u05dc\u05d9, \u05de\u05d5\u05e6\u05d2)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e1\u05e8\u05d9\u05d0\u05dc \u05e4\u05e2\u05d9\u05dc \u05d1\u05de\u05dc\u05d0\u05d9"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05e2\u05d5\u05d3\u05db\u05df \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05de\u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df"
    }
  },
  "required": [
    "linet_item_id",
    "serial"
  ]
}