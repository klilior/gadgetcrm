{
  "name": "LineProductDefinition",
  "type": "object",
  "properties": {
    "item_sku": {
      "type": "string",
      "description": "\u05de\u05e7\u05f4\u05d8 \u05de\u05d3\u05d5\u05d9\u05e7 \u05de\u05dc\u05d9\u05e0\u05d8",
      "index": true,
      "unique": true
    },
    "item_name_sample": {
      "type": "string",
      "description": "\u05d3\u05d5\u05d2\u05de\u05d4 \u05dc\u05e9\u05dd \u05d4\u05e4\u05e8\u05d9\u05d8 (\u05dc\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "is_line": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d4 \u05e7\u05d5 \u05e1\u05dc\u05d5\u05dc\u05e8",
      "index": true
    },
    "carrier_code": {
      "type": "string",
      "enum": [
        "PELEPHONE",
        "PARTNER",
        "HOT_MOBILE",
        "CELLCOM",
        "GOLAN",
        "WE4G"
      ],
      "description": "\u05e7\u05d5\u05d3 \u05d7\u05d1\u05e8\u05ea \u05e1\u05dc\u05d5\u05dc\u05e8"
    },
    "churn_window_months": {
      "type": "number",
      "description": "\u05d7\u05d5\u05d3\u05e9\u05d9 \u05e0\u05e2\u05d9\u05dc\u05d4 (churn window)"
    },
    "safety_buffer_days": {
      "type": "number",
      "default": 5,
      "description": "\u05d9\u05de\u05d9 \u05d1\u05d8\u05d7\u05d5\u05df \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05e4\u05e2\u05d9\u05dc",
      "index": true
    }
  },
  "required": [
    "item_sku"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc",
            "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}