{
  "name": "CommissionGroupMapping",
  "type": "object",
  "properties": {
    "commission_group_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05e2\u05de\u05dc\u05d5\u05ea",
      "index": true
    },
    "commission_group_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 (\u05dc\u05e0\u05d5\u05d7\u05d5\u05ea)"
    },
    "filters_json": {
      "type": "object",
      "additionalProperties": true,
      "description": "\u05ea\u05e0\u05d0\u05d9 \u05e1\u05d9\u05e0\u05d5\u05df \u05e2\u05dc \u05e9\u05d5\u05e8\u05d5\u05ea \u05de\u05db\u05d9\u05e8\u05d4"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05d4\u05de\u05d9\u05e4\u05d5\u05d9 (\u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 = \u05e7\u05d5\u05d3\u05dd)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d9\u05e4\u05d5\u05d9 \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "commission_group_id",
    "filters_json"
  ]
}