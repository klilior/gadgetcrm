{
  "name": "Employee",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05ea\u05de\u05e9 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9"
    },
    "employee_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e2\u05d5\u05d1\u05d3"
    },
    "id_number": {
      "type": "string",
      "description": "\u05ea\u05e2\u05d5\u05d3\u05ea \u05d6\u05d4\u05d5\u05ea"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05dc\u05d9\u05d3\u05d4"
    },
    "role": {
      "type": "string",
      "enum": [
        "\u05e0\u05e6\u05d9\u05d2",
        "\u05de\u05e0\u05d4\u05dc",
        "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea",
        "\u05d8\u05db\u05e0\u05d0\u05d9",
        "\u05de\u05dc\u05e7\u05d8"
      ],
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "department": {
      "type": "string",
      "enum": [
        "\u05de\u05db\u05d9\u05e8\u05d5\u05ea",
        "\u05e9\u05d9\u05e8\u05d5\u05ea",
        "\u05db\u05dc\u05dc\u05d9"
      ],
      "default": "\u05db\u05dc\u05dc\u05d9",
      "description": "\u05de\u05d7\u05dc\u05e7\u05d4"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "\u05d3\u05d5\u05d0\"\u05dc"
    },
    "password_hash": {
      "type": "string",
      "description": "\u05e1\u05d9\u05e1\u05de\u05d4 \u05de\u05d5\u05e6\u05e4\u05e0\u05ea"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05e4\u05e2\u05d9\u05dc"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "\u05db\u05e0\u05d9\u05e1\u05d4 \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    },
    "linet_employee_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05e2\u05d5\u05d1\u05d3 \u05d1\u05dc\u05d9\u05e0\u05d8"
    }
  },
  "required": [
    "username",
    "employee_name",
    "role",
    "email"
  ]
}