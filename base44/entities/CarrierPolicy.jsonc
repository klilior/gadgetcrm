{
  "name": "CarrierPolicy",
  "type": "object",
  "properties": {
    "carrier_code": {
      "type": "string",
      "description": "Unique carrier code (e.g., PELEPHONE, PARTNER, HOT, CELLCOM)",
      "unique": true,
      "index": true
    },
    "carrier_name": {
      "type": "string",
      "description": "Display name in Hebrew"
    },
    "churn_window_months": {
      "type": "number",
      "description": "Minimum months before churn eligibility",
      "default": 12
    },
    "safety_buffer_days": {
      "type": "number",
      "description": "Additional safety buffer days",
      "default": 30
    },
    "is_active": {
      "type": "boolean",
      "description": "Is this carrier active",
      "default": true
    }
  },
  "required": [
    "carrier_code",
    "carrier_name"
  ]
}