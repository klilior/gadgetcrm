    "updated_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05e2\u05d3\u05db\u05df \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 (\u05e9\u05dd/\u05de\u05d6\u05d4\u05d4)"
