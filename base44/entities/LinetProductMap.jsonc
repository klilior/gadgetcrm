    },
    "last_checked": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05e0\u05d1\u05d3\u05e7 \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05de\u05d5\u05dc Linet"
