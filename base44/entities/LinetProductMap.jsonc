      "unique": true,
      "index": true
    },
    "linet_item_id": {
      "type": "number",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e4\u05e8\u05d9\u05d8 \u05d1-Linet (item id)",
      "index": true
    },
    "linet_item_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d9\u05d8 \u05d1-Linet"
    },
    "linet_category_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d1-Linet"
    },
    "linet_stock_type": {
