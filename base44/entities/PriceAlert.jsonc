{
  "name": "PriceAlert",
  "type": "object",
  "properties": {
    "linked_product": {
      "type": "string",
      "description": "\u05de\u05d5\u05e6\u05e8 \u05de\u05e7\u05d5\u05e9\u05e8",
      "index": true
    },
    "linked_recommendation": {
      "type": "string",
      "description": "\u05d4\u05de\u05dc\u05e6\u05d4 \u05de\u05e7\u05d5\u05e9\u05e8\u05ea",
      "index": true
    },
    "alert_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d4\u05ea\u05e8\u05d0\u05d4"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "\u05d9\u05e8\u05d3\u05e0\u05d5 \u05de\u05ea\u05d7\u05ea \u05dc\u05de\u05d9\u05e7\u05d5\u05dd \u05e8\u05e6\u05d5\u05d9",
        "\u05d4\u05de\u05d9\u05e7\u05d5\u05dd \u05e9\u05dc\u05e0\u05d5 \u05d4\u05e9\u05ea\u05e4\u05e8",
        "\u05de\u05ea\u05d7\u05e8\u05d4 \u05de\u05e2\u05dc\u05d9\u05e0\u05d5 \u05e9\u05d9\u05e0\u05d4 \u05de\u05d7\u05d9\u05e8",
        "\u05de\u05ea\u05d7\u05e8\u05d4 \u05de\u05ea\u05d7\u05ea\u05d9\u05e0\u05d5 \u05e9\u05d9\u05e0\u05d4 \u05de\u05d7\u05d9\u05e8",
        "\u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05ea \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05de\u05d7\u05d9\u05e8",
        "\u05de\u05ea\u05d7\u05ea \u05dc\u05e8\u05d5\u05d5\u05d7 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9",
        "\u05de\u05dc\u05d7\u05de\u05ea \u05de\u05d7\u05d9\u05e8\u05d9\u05dd",
        "\u05e9\u05d2\u05d9\u05d0\u05ea \u05d1\u05d3\u05d9\u05e7\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05ea\u05e8\u05d0\u05d4"
    },
    "old_position": {
      "type": "number",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d9\u05e9\u05df"
    },
    "new_position": {
      "type": "number",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d7\u05d3\u05e9"
    },
    "message": {
      "type": "string",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "priority": {
      "type": "string",
      "enum": [
        "\u05e7\u05e8\u05d9\u05d8\u05d9",
        "\u05d2\u05d1\u05d5\u05d4",
        "\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9",
        "\u05e0\u05de\u05d5\u05da"
      ],
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "\u05e0\u05e7\u05e8\u05d0"
    },
    "requires_action": {
      "type": "boolean",
      "default": false,
      "description": "\u05d3\u05e8\u05d5\u05e9\u05d4 \u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "fingerprint": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 \u05db\u05e4\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea",
      "index": true
    },
    "source_snapshot": {
      "type": "string",
      "description": "\u05d1\u05d3\u05d9\u05e7\u05d4 \u05de\u05e7\u05d5\u05e8",
      "index": true
    },
    "source_prev_snapshot": {
      "type": "string",
      "description": "\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e7\u05d5\u05d3\u05de\u05ea \u05de\u05e7\u05d5\u05e8",
      "index": true
    }
  },
  "required": [
    "linked_product",
    "alert_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc",
            "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}