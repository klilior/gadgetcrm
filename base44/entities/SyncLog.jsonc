{
  "name": "SyncLog",
  "type": "object",
  "properties": {
    "sync_key": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df",
      "index": true
    },
    "run_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d4\u05ea\u05d7\u05dc\u05ea \u05d4\u05e8\u05d9\u05e6\u05d4"
    },
    "run_finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e1\u05d9\u05d5\u05dd \u05d4\u05e8\u05d9\u05e6\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED",
        "PARTIAL"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e8\u05d9\u05e6\u05d4"
    },
    "from_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d7\u05d9\u05dc\u05ea \u05d8\u05d5\u05d5\u05d7 \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df"
    },
    "to_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "\u05e1\u05d5\u05e3 \u05d8\u05d5\u05d5\u05d7 \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df"
    },
    "records_fetched": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05d4\u05ea\u05e7\u05d1\u05dc\u05d5 \u05de\u05dc\u05d9\u05e0\u05d8"
    },
    "records_created": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05e0\u05d5\u05e6\u05e8\u05d5"
    },
    "records_updated": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05e2\u05d5\u05d3\u05db\u05e0\u05d5"
    },
    "records_skipped": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05d3\u05d5\u05dc\u05d2\u05d5"
    },
    "error_message": {
      "type": "string",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05ea \u05e9\u05d2\u05d9\u05d0\u05d4 (\u05d0\u05dd \u05d9\u05e9)"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "HOURLY",
        "NIGHTLY",
        "MANUAL"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d8\u05e8\u05d9\u05d2\u05e8 \u05e9\u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df"
    },
    "details_json": {
      "type": "object",
      "additionalProperties": true,
      "description": "\u05e4\u05e8\u05d8\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 JSON"
    }
  },
  "required": [
    "sync_key",
    "run_started_at",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}