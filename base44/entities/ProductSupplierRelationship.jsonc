{
  "name": "ProductSupplierRelationship",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 Supplier \u05e7\u05e0\u05d5\u05e0\u05d9 (Suppliers.id)",
      "index": true
    },
    "product_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 Product \u05e7\u05e0\u05d5\u05e0\u05d9. \u05e0\u05e9\u05d0\u05e8 \u05e8\u05d9\u05e7 \u05db\u05dc \u05e2\u05d5\u05d3 \u05d4\u05d4\u05ea\u05d0\u05de\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05d5\u05d3\u05d0\u05d9\u05ea",
      "index": true
    },
    "product_sku": {
      "type": "string",
      "description": "\u05de\u05e7\"\u05d8 \u05de\u05e7\u05d5\u05e8 \u05dc\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05de\u05e2\u05d1\u05e8, \u05e2\u05d3 \u05dc-Product canonicalization",
      "index": true
    },
    "product_name_snapshot": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05d5\u05e6\u05e8 \u05db\u05e4\u05d9 \u05e9\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05de\u05e7\u05d5\u05e8 (\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9, \u05dc\u05d0 \u05dc\u05e9\u05db\u05ea\u05d5\u05d1)"
    },
    "role": {
      "type": "string",
      "enum": [
        "PURCHASE_SUPPLIER",
        "IMPORTER",
        "DISTRIBUTOR",
        "WARRANTY_PROVIDER",
        "REPAIR_LAB",
        "RMA_DESTINATION"
      ],
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05e1\u05e4\u05e7 \u05d1\u05d9\u05d7\u05e1 \u05dc\u05de\u05d5\u05e6\u05e8",
      "index": true
    },
    "relationship_key": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05d0\u05d9\u05d3\u05de\u05e4\u05d5\u05d8\u05e0\u05d8\u05d9\u05d5\u05ea: supplier_id:role:product_id|product_sku",
      "index": true,
      "unique": true
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d7\u05d9\u05dc\u05ea \u05ea\u05d5\u05e7\u05e3 \u05d4\u05e7\u05e9\u05e8"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time",
      "description": "\u05e1\u05d5\u05e3 \u05ea\u05d5\u05e7\u05e3 \u05d4\u05e7\u05e9\u05e8. \u05e8\u05d9\u05e7 = \u05e4\u05e2\u05d9\u05dc"
    },
    "priority": {
      "type": "number",
      "default": 100,
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05d1\u05d7\u05d9\u05e8\u05d4, \u05e0\u05de\u05d5\u05da = \u05e2\u05d3\u05d9\u05e3"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d4\u05d5 \u05d4\u05e1\u05e4\u05e7 \u05d4\u05e8\u05d0\u05e9\u05d9 \u05dc\u05de\u05d5\u05e6\u05e8 \u05d1\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d6\u05d4"
    },
    "product_match_method": {
      "type": "string",
      "enum": [
        "none",
        "sku_only",
        "exact_sku_to_product",
        "manual"
      ],
      "default": "none",
      "description": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05e7\u05d1\u05e2\u05d4 \u05d4\u05ea\u05d0\u05de\u05ea \u05d4\u05de\u05d5\u05e6\u05e8. \u05d0\u05d9\u05df \u05e0\u05d9\u05d7\u05d5\u05e9 \u05de\u05d5\u05e6\u05e8"
    },
    "source": {
      "type": "string",
      "enum": [
        "MIGRATION",
        "USER",
        "INTEGRATION",
        "SYSTEM"
      ],
      "default": "MIGRATION",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d9\u05e6\u05d9\u05e8\u05ea \u05d4\u05e7\u05e9\u05e8",
      "index": true
    },
    "correlation_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e2\u05e7\u05d1 \u05dc\u05d6\u05e8\u05d9\u05de\u05d4 \u05e9\u05d9\u05e6\u05e8\u05d4 \u05d0\u05ea \u05d4\u05e7\u05e9\u05e8",
      "index": true
    },
    "migration_run_id": {
      "type": "string",
      "description": "MigrationRun \u05e9\u05d1\u05de\u05e1\u05d2\u05e8\u05ea\u05d5 \u05e0\u05d5\u05e6\u05e8 \u05d4\u05e7\u05e9\u05e8",
      "index": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "\u05de\u05d8\u05d0-\u05d3\u05d0\u05d8\u05d4 \u05e7\u05d5\u05de\u05e4\u05e7\u05d8\u05d9\u05ea. \u05dc\u05dc\u05d0 \u05e1\u05d5\u05d3\u05d5\u05ea \u05d5\u05dc\u05dc\u05d0 payloads \u05de\u05dc\u05d0\u05d9\u05dd"
    }
  },
  "required": [
    "supplier_id",
    "role",
    "relationship_key"
  ]
}