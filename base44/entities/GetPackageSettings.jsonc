{
  "name": "GetPackageSettings",
  "type": "object",
  "properties": {
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "environment": {
      "type": "string",
      "enum": [
        "sandbox",
        "production"
      ],
      "default": "sandbox",
      "description": "\u05e1\u05d1\u05d9\u05d1\u05ea \u05e2\u05d1\u05d5\u05d3\u05d4"
    },
    "sandbox_api_base_url": {
      "type": "string",
      "default": "https://sandbox-apiv2.getpackage.com",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea API \u05e1\u05e0\u05d3\u05d1\u05d5\u05e7\u05e1"
    },
    "production_api_base_url": {
      "type": "string",
      "default": "https://apiv2.getpackage.com",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea API \u05e4\u05e8\u05d5\u05d3\u05e7\u05e9\u05df"
    },
    "api_token": {
      "type": "string",
      "description": "API Token"
    },
    "business_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e2\u05e1\u05e7"
    },
    "default_pickup_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8 \u05dc\u05d0\u05d9\u05e1\u05d5\u05e3"
    },
    "default_pickup_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05d0\u05d9\u05e1\u05d5\u05e3"
    },
    "default_pickup_address": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d0\u05d9\u05e1\u05d5\u05e3"
    },
    "default_pickup_city": {
      "type": "string",
      "description": "\u05e2\u05d9\u05e8 \u05d0\u05d9\u05e1\u05d5\u05e3"
    },
    "default_pickup_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05dc\u05d0\u05d9\u05e1\u05d5\u05e3"
    },
    "send_tracking_sms": {
      "type": "boolean",
      "default": true,
      "description": "\u05e9\u05dc\u05d7 SMS \u05e2\u05dd \u05e7\u05d9\u05e9\u05d5\u05e8 \u05de\u05e2\u05e7\u05d1"
    },
    "auto_create_only_when_ready": {
      "type": "boolean",
      "default": true,
      "description": "\u05e6\u05d5\u05e8 \u05de\u05e9\u05dc\u05d5\u05d7 \u05e8\u05e7 \u05db\u05e9\u05d4\u05d4\u05d6\u05de\u05e0\u05d4 \u05de\u05d5\u05db\u05e0\u05d4"
    }
  },
  "required": []
}