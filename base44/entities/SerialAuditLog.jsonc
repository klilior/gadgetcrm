{
  "name": "SerialAuditLog",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d6\u05de\u05e0\u05d4",
      "index": true
    },
    "order_item_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05d5\u05e8\u05ea \u05de\u05d5\u05e6\u05e8",
      "index": true
    },
    "sku": {
      "type": "string",
      "description": "\u05de\u05e7\"\u05d8 \u05de\u05e7\u05d5\u05e8"
    },
    "linet_item_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d9\u05d8 \u05dc\u05d9\u05e0\u05d8"
    },
    "serial": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e1\u05d9\u05d3\u05d5\u05e8\u05d9 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "action": {
      "type": "string",
      "enum": [
        "mark_serial",
        "unmark_serial",
        "select_serial",
        "change_serial",
        "verify_serial",
        "map_linet_item",
        "issue_invoice",
        "issue_invoice_failed",
        "shipment_blocked",
        "order_complete_blocked"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4",
      "index": true
    },
    "old_value": {
      "type": "string",
      "description": "\u05e2\u05e8\u05da \u05e7\u05d5\u05d3\u05dd"
    },
    "new_value": {
      "type": "string",
      "description": "\u05e2\u05e8\u05da \u05d7\u05d3\u05e9"
    },
    "user": {
      "type": "string",
      "description": "\u05de\u05d9 \u05d1\u05d9\u05e6\u05e2 (\u05e9\u05dd/\u05de\u05d6\u05d4\u05d4)"
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "blocked",
        "error"
      ],
      "description": "\u05ea\u05d5\u05e6\u05d0\u05ea \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "error_message": {
      "type": "string",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05ea \u05e9\u05d2\u05d9\u05d0\u05d4 \u05d0\u05dd \u05d9\u05e9"
    }
  },
  "required": [
    "action"
  ]
}