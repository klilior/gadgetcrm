{
  "name": "AttendanceEdit",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05d5\u05d1\u05d3",
      "index": true
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "requested_change": {
      "type": "object",
      "additionalProperties": true,
      "description": "\u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05de\u05d1\u05d5\u05e7\u05e9"
    },
    "reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "index": true
    },
    "manager_comment": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05ea \u05de\u05e0\u05d4\u05dc"
    },
    "approver_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d0\u05e9\u05e8"
    }
  },
  "required": [
    "user_id",
    "date",
    "requested_change",
    "reason"
  ]
}