{
  "name": "Invoices",
  "type": "object",
  "properties": {
    "supplier": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e4\u05e7",
      "index": true
    },
    "detected_supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e4\u05e7 \u05e9\u05d6\u05d5\u05d4\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea",
      "index": true
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05de\u05e1",
        "\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05d6\u05d9\u05db\u05d5\u05d9"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05de\u05e1\u05de\u05da"
    },
    "doc_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e1\u05de\u05da"
    },
    "normalized_doc_number": {
      "type": "string",
      "description": "\u05d4\u05dc\u05d9\u05d1\u05d4 \u05d4\u05de\u05e1\u05e4\u05e8\u05d9\u05ea \u05d4\u05de\u05e0\u05d5\u05e8\u05de\u05dc\u05ea",
      "index": true
    },
    "doc_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e4\u05e7\u05ea \u05d4\u05de\u05e1\u05de\u05da (\u05dc\u05d0 \u05de\u05d5\u05e2\u05d3 \u05ea\u05e9\u05dc\u05d5\u05dd)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05ea\u05e9\u05dc\u05d5\u05dd (\u05e0\u05e4\u05e8\u05d3 \u05de\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05e1\u05de\u05da; null \u05d0\u05dd \u05d0\u05d9\u05df)"
    },
    "currency": {
      "type": "string",
      "enum": [
        "ILS",
        "USD",
        "EUR"
      ],
      "description": "\u05de\u05d8\u05d1\u05e2"
    },
    "subtotal_before_vat": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05dc\u05e4\u05e0\u05d9 \u05de\u05e2\u05f4\u05de"
    },
    "vat_amount": {
      "type": "number",
      "description": "\u05de\u05e2\u05f4\u05de"
    },
    "total_with_vat": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05db\u05d5\u05dc\u05dc \u05de\u05e2\u05f4\u05de"
    },
    "extracted_subtotal_before_vat": {
      "type": "number",
      "description": "\u05d4\u05e2\u05e8\u05da \u05e9\u05d7\u05d5\u05dc\u05e5 \u05de\u05d4\u05de\u05e1\u05de\u05da \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d7\u05dc\u05e4\u05d4 \u05d1\u05de\u05e7\u05d5\u05e8 \u05dc\u05d9\u05e0\u05d8"
    },
    "extracted_vat_amount": {
      "type": "number",
      "description": "\u05de\u05e2\u05f4\u05de \u05e9\u05d7\u05d5\u05dc\u05e5 \u05de\u05d4\u05de\u05e1\u05de\u05da \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d7\u05dc\u05e4\u05d4 \u05d1\u05de\u05e7\u05d5\u05e8 \u05dc\u05d9\u05e0\u05d8"
    },
    "extracted_total_with_vat": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05e9\u05d7\u05d5\u05dc\u05e5 \u05de\u05d4\u05de\u05e1\u05de\u05da \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d7\u05dc\u05e4\u05d4 \u05d1\u05de\u05e7\u05d5\u05e8 \u05dc\u05d9\u05e0\u05d8"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "\u05e6\u05d9\u05d5\u05df \u05d5\u05d5\u05d3\u05d0\u05d5\u05ea \u05e9\u05dc \u05d4-AI (\u05d8\u05dc\u05de\u05d8\u05e8\u05d9\u05d4 \u05d1\u05dc\u05d1\u05d3 \u2014 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d0\u05e9\u05e8 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea)"
    },
    "validation_passed": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05e2\u05d1\u05e8\u05d4 \u05d0\u05ea \u05e9\u05e2\u05e8 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d4\u05d3\u05d8\u05e8\u05de\u05d9\u05e0\u05d9\u05e1\u05d8\u05d9",
      "index": true
    },
    "validation_failures": {
      "type": "string",
      "description": "\u05db\u05e9\u05dc\u05d9 \u05d1\u05d3\u05d9\u05e7\u05d4 \u05e7\u05e8\u05d9\u05d8\u05d9\u05d9\u05dd (\u05de\u05d5\u05e4\u05e8\u05d3\u05d9\u05dd \u05d1-|)"
    },
    "validation_warnings": {
      "type": "string",
      "description": "\u05d0\u05d6\u05d4\u05e8\u05d5\u05ea \u05d1\u05d3\u05d9\u05e7\u05d4 (\u05de\u05d5\u05e4\u05e8\u05d3\u05d5\u05ea \u05d1-|)"
    },
    "validated_fields": {
      "type": "string",
      "description": "\u05e9\u05d3\u05d5\u05ea \u05e9\u05e0\u05d1\u05d3\u05e7\u05d5 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4"
    },
    "validation_version": {
      "type": "string",
      "description": "\u05d2\u05e8\u05e1\u05ea \u05e9\u05e2\u05e8 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea"
    },
    "auto_approved": {
      "type": "boolean",
      "description": "\u05d0\u05d5\u05e9\u05e8\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05de\u05e2\u05d1\u05e8 \u05db\u05dc \u05d4\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea",
      "index": true
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "\u05e0\u05e7\u05e8\u05d0 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4",
        "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05de\u05d5\u05ea",
        "\u05d0\u05d5\u05e9\u05e8",
        "\u05e0\u05d3\u05d7\u05d4"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e0\u05d9\u05ea\u05d5\u05d7"
    },
    "reviewed_by": {
      "type": "string",
      "description": "\u05d0\u05d5\u05e9\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d0\u05d9\u05de\u05d5\u05ea"
    },
    "source_intake": {
      "type": "string",
      "description": "\u05de\u05e1\u05de\u05da \u05de\u05e7\u05d5\u05e8",
      "index": true
    },
    "source_document_index": {
      "type": "number",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05de\u05e1\u05de\u05da \u05d1\u05ea\u05d5\u05da \u05e7\u05d5\u05d1\u05e5 \u05d4\u05e7\u05dc\u05d9\u05d8\u05d4 (1 = \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05d4\u05de\u05e7\u05d5\u05e9\u05e8\u05ea/\u05e9\u05d5\u05e8\u05e9). \u05de\u05e4\u05ea\u05d7 \u05d9\u05e6\u05d9\u05d1 \u05d9\u05d7\u05d3 \u05e2\u05dd source_intake \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d9\u05e6\u05d9\u05e8\u05ea \u05db\u05e4\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05d1\u05e0\u05e1\u05d9\u05d5\u05df \u05d7\u05d5\u05d6\u05e8 \u05e9\u05dc \u05e7\u05d5\u05d1\u05e5 \u05de\u05e8\u05d5\u05d1\u05d4 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05d5\u05ea",
      "index": true
    },
    "duplicate_key": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 \u05db\u05e4\u05d9\u05dc\u05d5\u05ea",
      "index": true
    },
    "field_provenance_json": {
      "type": "string",
      "description": "D2b2: JSON \u05e7\u05d5\u05de\u05e4\u05e7\u05d8\u05d9 \u05dc\u05e9\u05d3\u05d5\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9\u05d9\u05dd \u2014 \u05ea\u05e6\u05dc\u05d5\u05dd \u05de\u05e7\u05d5\u05e8\u05d9 \u05d7\u05d3-\u05e4\u05e2\u05de\u05d9 (ORIGINAL_DOCUMENT), \u05de\u05d5\u05e2\u05de\u05d3 AI \u05d0\u05d7\u05e8\u05d5\u05df, \u05de\u05d5\u05e2\u05de\u05d3 \u05dc\u05d9\u05e0\u05d8, \u05d5\u05d4\u05e2\u05e8\u05da \u05d4\u05e0\u05d1\u05d7\u05e8 \u05e2\u05dd \u05d4\u05de\u05e7\u05d5\u05e8 (AI / ORIGINAL_DOCUMENT / VALIDATED / LINET / HUMAN), \u05d4\u05e1\u05d9\u05d1\u05d4 \u05d5\u05d7\u05d5\u05ea\u05de\u05ea \u05d6\u05de\u05df. \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d1\u05dc\u05d1\u05d3 \u2014 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d0\u05e9\u05e8 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "processing_events_json": {
      "type": "string",
      "description": "D2b2: \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05e2\u05d9\u05d1\u05d5\u05d3 \u05e7\u05d5\u05de\u05e4\u05e7\u05d8\u05d9\u05ea \u05d1\u05e1\u05d3\u05e8 \u05db\u05e8\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 (\u05e2\u05d3 20 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d9\u05dd): \u05e1\u05d5\u05d2 \u05d0\u05d9\u05e8\u05d5\u05e2, \u05d7\u05d5\u05ea\u05de\u05ea \u05d6\u05de\u05df, \u05ea\u05d5\u05e6\u05d0\u05d4/\u05e1\u05d9\u05d1\u05d4 \u05d5\u05de\u05d8\u05d0-\u05d3\u05d0\u05d8\u05d4 \u05e7\u05d8\u05df. \u05dc\u05dc\u05d0 \u05d8\u05e7\u05e1\u05d8 \u05de\u05e1\u05de\u05da \u05d5\u05dc\u05dc\u05d0 \u05d7\u05d9\u05dc\u05d5\u05e5 \u05de\u05dc\u05d0"
    },
    "linet_match_status": {
      "type": "string",
      "enum": [
        "unchecked",
        "matched",
        "conflict",
        "possible_match",
        "missing_in_linet",
        "matched_duplicate"
      ],
      "default": "unchecked",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e6\u05dc\u05d1\u05d4 \u05de\u05d5\u05dc \u05dc\u05d9\u05e0\u05d8. matched = \u05d0\u05d5\u05ea\u05d4 \u05e2\u05e1\u05e7\u05d4 \u05d0\u05d5\u05de\u05ea\u05d4. matched_duplicate = \u05de\u05d9\u05d5\u05e9\u05df, \u05dc\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8 \u05d1\u05dc\u05d1\u05d3",
      "index": true
    },
    "source_of_truth": {
      "type": "string",
      "enum": [
        "extracted",
        "LINET"
      ],
      "default": "extracted",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05e2\u05e8\u05db\u05d9\u05dd \u05d4\u05e2\u05e1\u05e7\u05d9\u05d9\u05dd \u05d4\u05e1\u05d5\u05e4\u05d9\u05d9\u05dd \u05d1\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "linet_provenance_json": {
      "type": "string",
      "description": "JSON \u05e7\u05d5\u05de\u05e4\u05e7\u05d8\u05d9: \u05e2\u05e8\u05da \u05de\u05e7\u05d5\u05de\u05d9, \u05e2\u05e8\u05da \u05dc\u05d9\u05e0\u05d8, \u05d4\u05de\u05e7\u05d5\u05e8 \u05e9\u05e0\u05d1\u05d7\u05e8, \u05d4\u05e1\u05d9\u05d1\u05d4, \u05d2\u05e8\u05e1\u05ea \u05d4\u05db\u05dc\u05dc \u05d5\u05d7\u05d5\u05ea\u05de\u05ea \u05d6\u05de\u05df"
    },
    "linet_conflict_reason_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05e1\u05ea\u05d9\u05e8\u05d4: LINET_TOTAL_CONFLICT / LINET_DATE_CONFLICT / LINET_SUPPLIER_CONFLICT / LINET_LINE_CONFLICT",
      "index": true
    },
    "linet_total_with_vat": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05db\u05d5\u05dc\u05dc \u05de\u05e2\u05f4\u05de \u05dc\u05e4\u05d9 \u05de\u05e1\u05de\u05da \u05d4\u05e8\u05db\u05e9 \u05d1\u05dc\u05d9\u05e0\u05d8 (\u05dc\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4)"
    },
    "linet_doc_date": {
      "type": "string",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05e1\u05de\u05da \u05dc\u05e4\u05d9 \u05dc\u05d9\u05e0\u05d8 (\u05dc\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4)"
    },
    "linet_purchase_document_id": {
      "type": "string",
      "description": "\u05e8\u05e9\u05d5\u05de\u05ea \u05de\u05e1\u05de\u05da \u05e8\u05db\u05e9 13 \u05ea\u05d5\u05d0\u05de\u05ea",
      "index": true
    },
    "linet_doc_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e1\u05de\u05da \u05d1\u05dc\u05d9\u05e0\u05d8"
    },
    "linet_doc_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e1\u05de\u05da \u05e8\u05db\u05e9 \u05e4\u05e0\u05d9\u05de\u05d9 \u05d1\u05dc\u05d9\u05e0\u05d8"
    },
    "linet_supplier_invoice_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05e1\u05e4\u05e7 \u05d1\u05dc\u05d9\u05e0\u05d8"
    },
    "linet_match_reason": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d1\u05e8 \u05d4\u05e6\u05dc\u05d1\u05d4"
    },
    "linet_matched_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05e6\u05dc\u05d1\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "expense_category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d5\u05e6\u05d0\u05d4 \u05d9\u05d3\u05e0\u05d9\u05ea/\u05de\u05e4\u05d5\u05e8\u05d8\u05ea"
    },
    "is_goods_invoice": {
      "type": "boolean",
      "default": false,
      "description": "\u05e1\u05d9\u05de\u05d5\u05df \u05d9\u05d3\u05e0\u05d9 \u05db\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05e1\u05d7\u05d5\u05e8\u05d4"
    },
    "is_recurring_expense": {
      "type": "boolean",
      "default": false,
      "description": "\u05e1\u05d9\u05de\u05d5\u05df \u05d9\u05d3\u05e0\u05d9 \u05db\u05d4\u05d5\u05e6\u05d0\u05d4 \u05e7\u05d1\u05d5\u05e2\u05d4"
    },
    "invoice_classification": {
      "type": "string",
      "enum": [
        "fixed",
        "goods",
        "mixed"
      ],
      "description": "\u05e1\u05d9\u05db\u05d5\u05dd \u05e1\u05d9\u05d5\u05d5\u05d2 \u05e9\u05d5\u05e8\u05d5\u05ea \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea",
      "index": true
    },
    "classification_status": {
      "type": "string",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e1\u05d9\u05d5\u05d5\u05d2: auto_classified / needs_review / manually_corrected",
      "index": true
    },
    "classification_reason": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d1\u05e8 \u05dc\u05e1\u05d9\u05db\u05d5\u05dd \u05d4\u05e1\u05d9\u05d5\u05d5\u05d2"
    },
    "ai_debug_last_extraction_json": {
      "type": "string",
      "description": "\u05d3\u05d9\u05d1\u05d0\u05d2: JSON \u05d7\u05d9\u05dc\u05d5\u05e5 \u05d0\u05d7\u05e8\u05d5\u05df"
    },
