{
  "name": "VeloSession",
  "type": "object",
  "properties": {
    "jwt": {
      "type": "string",
      "description": "JWT Token \u05de-Velo"
    },
    "expiry": {
      "type": "number",
      "description": "\u05ea\u05d5\u05e7\u05e3 \u05d1\u05e9\u05e0\u05d9\u05d5\u05ea"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05d5\u05e0\u05e4\u05e7"
    },
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1-Velo"
    }
  },
  "required": [
    "jwt",
    "expiry",
    "issued_at"
  ]
}