{
  "name": "PriceRecommendation",
  "type": "object",
  "properties": {
    "linked_product": {
      "type": "string",
      "description": "\u05de\u05d5\u05e6\u05e8 \u05de\u05e7\u05d5\u05e9\u05e8",
      "index": true
    },
    "linked_snapshot": {
      "type": "string",
      "description": "\u05d1\u05d3\u05d9\u05e7\u05d4 \u05de\u05e7\u05d5\u05e9\u05e8\u05ea",
      "index": true
    },
    "recommendation_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d4\u05de\u05dc\u05e6\u05d4"
    },
    "current_position": {
      "type": "number",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "desired_position": {
      "type": "number",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05e8\u05e6\u05d5\u05d9"
    },
    "recommendation_type": {
      "type": "string",
      "enum": [
        "\u05d4\u05d5\u05e8\u05d3 \u05de\u05d7\u05d9\u05e8 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05d9\u05e2 \u05dc\u05d9\u05e2\u05d3",
        "\u05d4\u05e2\u05dc\u05d4 \u05de\u05d7\u05d9\u05e8 - \u05d9\u05e9 \u05de\u05e7\u05d5\u05dd",
        "\u05d4\u05d9\u05e9\u05d0\u05e8 \u05d1\u05de\u05d7\u05d9\u05e8 \u05e0\u05d5\u05db\u05d7\u05d9",
        "\u05d0\u05d6\u05d4\u05e8\u05d4 - \u05de\u05ea\u05d7\u05ea \u05dc\u05e8\u05d5\u05d5\u05d7 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9",
        "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d2\u05d9\u05e2 \u05dc\u05d9\u05e2\u05d3"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05dc\u05e6\u05d4"
    },
    "recommended_action": {
      "type": "string",
      "description": "\u05e4\u05e2\u05d5\u05dc\u05d4 \u05de\u05d5\u05de\u05dc\u05e6\u05ea"
    },
    "new_suggested_price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05de\u05d5\u05e6\u05e2 (\u20aa)"
    },
    "profit_at_suggested_price": {
      "type": "number",
      "description": "\u05e8\u05d5\u05d5\u05d7 \u05d1\u05de\u05d7\u05d9\u05e8 \u05de\u05d5\u05e6\u05e2 (\u20aa)"
    },
    "margin_at_suggested_price": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05e8\u05d5\u05d5\u05d7 \u05d1\u05de\u05d7\u05d9\u05e8 \u05de\u05d5\u05e6\u05e2 (%)"
    },
    "gap_to_position_above": {
      "type": "number",
      "description": "\u05e4\u05e2\u05e8 \u05de\u05de\u05e7\u05d5\u05dd \u05de\u05e2\u05dc (\u20aa)"
    },
    "gap_to_position_below": {
      "type": "number",
      "description": "\u05e4\u05e2\u05e8 \u05de\u05de\u05e7\u05d5\u05dd \u05de\u05ea\u05d7\u05ea (\u20aa)"
    },
    "is_margin_acceptable": {
      "type": "boolean",
      "default": false,
      "description": "\u05e8\u05d5\u05d5\u05d7 \u05de\u05e7\u05d5\u05d1\u05dc"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05d7\u05d3\u05e9",
        "\u05e0\u05d1\u05d3\u05e7",
        "\u05d1\u05d5\u05e6\u05e2",
        "\u05d4\u05ea\u05e2\u05dc\u05de\u05d5\u05ea"
      ],
      "default": "\u05d7\u05d3\u05e9",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    }
  },
  "required": [
    "linked_product"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc",
            "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}