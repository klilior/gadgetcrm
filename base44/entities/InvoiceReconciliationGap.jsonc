{
  "name": "InvoiceReconciliationGap",
  "type": "object",
  "properties": {
    "gap_key": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 \u05e4\u05e2\u05e8 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9",
      "index": true,
      "unique": true
    },
    "direction": {
      "type": "string",
      "enum": [
        "missing_in_linet",
        "missing_in_system",
        "ambiguous_match"
      ],
      "description": "\u05db\u05d9\u05d5\u05d5\u05df \u05d4\u05e4\u05e2\u05e8",
      "index": true
    },
    "invoice_id": {
      "type": "string",
      "description": "\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05d1\u05de\u05e2\u05e8\u05db\u05ea",
      "index": true
    },
    "linet_purchase_document_id": {
      "type": "string",
      "description": "\u05de\u05e1\u05de\u05da \u05e8\u05db\u05e9 13",
      "index": true
    },
    "doc_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05e1\u05e4\u05e7"
    },
    "supplier_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e1\u05e4\u05e7"
    },
    "doc_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "total_with_vat": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05db\u05d5\u05dc\u05dc"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "ignored"
      ],
      "default": "open",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e4\u05e2\u05e8",
      "index": true
    },
    "reason": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d1\u05e8 \u05d4\u05e4\u05e2\u05e8"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d6\u05d9\u05d4\u05d5\u05d9"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05e4\u05ea\u05e8\u05d5\u05df"
    }
  },
  "required": [
    "gap_key",
    "direction",
    "status"
  ]
}