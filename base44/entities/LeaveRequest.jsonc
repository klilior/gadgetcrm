{
  "name": "LeaveRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05d5\u05d1\u05d3",
      "index": true
    },
    "type": {
      "type": "string",
      "enum": [
        "vacation",
        "sick",
        "unpaid",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d9\u05e2\u05d3\u05e8\u05d5\u05ea"
    },
    "date_from": {
      "type": "string",
      "format": "date",
      "description": "\u05de\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "date_to": {
      "type": "string",
      "format": "date",
      "description": "\u05e2\u05d3 \u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "days_count": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05de\u05d9\u05dd"
    },
    "reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "index": true
    },
    "approver_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d0\u05e9\u05e8"
    },
    "manager_comment": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05ea \u05de\u05e0\u05d4\u05dc"
    }
  },
  "required": [
    "user_id",
    "type",
    "date_from",
    "date_to",
    "days_count"
  ]
}