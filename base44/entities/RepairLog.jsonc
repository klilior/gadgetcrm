{
  "name": "RepairLog",
  "type": "object",
  "properties": {
    "repair_id": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05ea\u05d9\u05e7\u05d5\u05df",
      "index": true
    },
    "actor_user_id": {
      "type": "string",
      "description": "\u05de\u05e9\u05ea\u05de\u05e9 \u05de\u05d1\u05e6\u05e2"
    },
    "action": {
      "type": "string",
      "description": "\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "details": {
      "type": "string",
      "description": "\u05e4\u05e8\u05d8\u05d9\u05dd"
    }
  },
  "required": [
    "repair_id",
    "action"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.actor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "\u05de\u05e0\u05d4\u05dc",
                "\u05d8\u05db\u05e0\u05d0\u05d9",
                "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.actor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "\u05de\u05e0\u05d4\u05dc",
                "\u05d8\u05db\u05e0\u05d0\u05d9",
                "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}