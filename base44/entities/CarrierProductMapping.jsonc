{
  "name": "CarrierProductMapping",
  "type": "object",
  "properties": {
    "carrier_code": {
      "type": "string",
      "description": "Carrier code this mapping belongs to",
      "index": true
    },
    "product_sku_exact": {
      "type": "string",
      "description": "Exact SKU match"
    },
    "product_sku_prefix": {
      "type": "string",
      "description": "SKU prefix match"
    },
    "name_contains": {
      "type": "string",
      "description": "Product name contains text"
    },
    "priority": {
      "type": "number",
      "description": "Matching priority (higher = checked first)",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "description": "Is this mapping active",
      "default": true
    }
  },
  "required": [
    "carrier_code"
  ]
}