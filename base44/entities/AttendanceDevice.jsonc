{
  "name": "AttendanceDevice",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05db\u05e9\u05d9\u05e8"
    },
    "site_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d0\u05ea\u05e8"
    },
    "type": {
      "type": "string",
      "enum": [
        "browser",
        "kiosk",
        "fingerprint"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05de\u05db\u05e9\u05d9\u05e8"
    },
    "device_token": {
      "type": "string",
      "description": "\u05d8\u05d5\u05e7\u05df \u05de\u05db\u05e9\u05d9\u05e8"
    },
    "ip_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea IP \u05de\u05d0\u05d5\u05e9\u05e8\u05d9\u05dd"
    },
    "geo_center_lat": {
      "type": "number",
      "description": "\u05e7\u05d5 \u05e8\u05d5\u05d7\u05d1 \u05de\u05e8\u05db\u05d6"
    },
    "geo_center_lng": {
      "type": "number",
      "description": "\u05e7\u05d5 \u05d0\u05d5\u05e8\u05da \u05de\u05e8\u05db\u05d6"
    },
    "geo_radius_m": {
      "type": "integer",
      "description": "\u05e8\u05d3\u05d9\u05d5\u05e1 \u05d1\u05de\u05d8\u05e8\u05d9\u05dd"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc",
            "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}