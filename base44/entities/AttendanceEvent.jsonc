{
  "name": "AttendanceEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05d5\u05d1\u05d3",
      "index": true
    },
    "event_type": {
      "type": "string",
      "enum": [
        "in",
        "out",
        "auto_out",
        "break_in",
        "break_out"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2",
      "index": true
    },
    "tz": {
      "type": "string",
      "default": "Asia/Jerusalem",
      "description": "\u05d0\u05d6\u05d5\u05e8 \u05d6\u05de\u05df"
    },
    "source": {
      "type": "string",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 (browser/kiosk/biometric)"
    },
    "ip": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea IP"
    },
    "device_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05db\u05e9\u05d9\u05e8"
    },
    "geo_lat": {
      "type": "number",
      "description": "\u05e7\u05d5 \u05e8\u05d5\u05d7\u05d1"
    },
    "geo_lng": {
      "type": "number",
      "description": "\u05e7\u05d5 \u05d0\u05d5\u05e8\u05da"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "user_id",
    "event_type",
    "event_time",
    "source"
  ]
}