{
  "name": "Order",
  "type": "object",
  "properties": {
    "external_order_number": {
      "type": "string",
      "description": "\u05de\u05e1' \u05d4\u05d6\u05de\u05e0\u05d4 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 (\u05de-WooCommerce)",
      "index": true,
      "unique": true
    },
    "client_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05dc\u05e7\u05d5\u05d7 (\u05de\u05e7\u05d5\u05de\u05d9)",
      "index": true
    },
    "order_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "status": {
      "type": "string",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d6\u05de\u05e0\u05d4 (\u05de-WooCommerce)"
    },
    "total": {
      "type": "string",
      "description": "\u05e1\u05db\u05d5\u05dd \u05db\u05d5\u05dc\u05dc"
    },
    "shipping_total": {
      "type": "string",
      "description": "\u05e2\u05dc\u05d5\u05ea \u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "shipping_method": {
      "type": "string",
      "description": "\u05e9\u05d9\u05d8\u05ea \u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "payment_method_title": {
      "type": "string",
      "description": "\u05d0\u05de\u05e6\u05e2\u05d9 \u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "customer_note": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05ea \u05dc\u05e7\u05d5\u05d7"
    },
    "raw_data_billing": {
      "type": "string",
      "description": "\u05de\u05d9\u05d3\u05e2 \u05d7\u05d9\u05d5\u05d1 \u05d2\u05d5\u05dc\u05de\u05d9 (JSON stringified)"
    },
    "pickup_point_data": {
      "type": "string",
      "description": "\u05de\u05d9\u05d3\u05e2 \u05e0\u05e7\u05d5\u05d3\u05ea \u05d0\u05d9\u05e1\u05d5\u05e3 \u05de-WooCommerce (JSON stringified)"
    },
    "tracking_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e2\u05e7\u05d1 \u05de\u05e9\u05dc\u05d5\u05d7",
      "index": true
    },
    "tracking_carrier": {
      "type": "string",
      "description": "\u05d7\u05d1\u05e8\u05ea \u05de\u05e9\u05dc\u05d5\u05d7 (cargo/ups/getpackage/other)"
    },
    "tracking_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05de\u05e2\u05e7\u05d1 \u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "shipment_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05e0\u05d5\u05e6\u05e8 \u05d4\u05de\u05e9\u05dc\u05d5\u05d7 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05e4\u05d5\u05e2\u05dc \u2014 \u05e7\u05d5\u05d1\u05e2 \u05e0\u05e2\u05d9\u05dc\u05ea \u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "invoice_issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05d5\u05e0\u05e4\u05e7\u05d4 \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea (\u05d0\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9)"
    },
    "order_locked": {
      "type": "boolean",
      "default": false,
      "description": "true \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05d1\u05e8\u05d2\u05e2 \u05e9-shipment_created_at \u05de\u05dc\u05d0 \u2014 \u05dc\u05d0 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d9\u05d3\u05e0\u05d9"
    },
    "followup_records": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05d6\u05d4\u05d9 OrderFollowup \u05e9\u05e0\u05e4\u05ea\u05d7\u05d5 \u05e2\u05dc \u05d4\u05d6\u05de\u05e0\u05d4 \u05d6\u05d5"
    }
  },
  "required": [
    "external_order_number"
  ]
}