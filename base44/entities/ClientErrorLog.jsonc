{
  "name": "ClientErrorLog",
  "type": "object",
  "properties": {
    "status": {
      "type": "number",
      "description": "HTTP status code of the failed request"
    },
    "method": {
      "type": "string",
      "description": "HTTP method"
    },
    "url": {
      "type": "string",
      "description": "Request URL that failed"
    },
    "page": {
      "type": "string",
      "description": "App page path where it happened"
    },
    "happened_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the failure occurred"
    }
  },
  "required": [
    "url"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}