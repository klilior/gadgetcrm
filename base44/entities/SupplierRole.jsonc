{
  "name": "SupplierRole",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 Supplier \u05e7\u05e0\u05d5\u05e0\u05d9 (Suppliers.id)",
      "index": true
    },
    "role": {
      "type": "string",
      "enum": [
        "PURCHASE_SUPPLIER",
        "IMPORTER",
        "DISTRIBUTOR",
        "WARRANTY_PROVIDER",
        "REPAIR_LAB",
        "RMA_DESTINATION"
      ],
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9 \u05e9\u05dc \u05d4\u05e1\u05e4\u05e7 (\u05dc\u05d0 \u05ea\u05dc\u05d5\u05d9 \u05de\u05d5\u05e6\u05e8)",
      "index": true
    },
    "role_key": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05d0\u05d9\u05d3\u05de\u05e4\u05d5\u05d8\u05e0\u05d8\u05d9\u05d5\u05ea: supplier_id:role",
      "index": true,
      "unique": true
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e4\u05e2\u05d9\u05dc"
    },
    "evidence": {
      "type": "string",
      "description": "\u05d4\u05e8\u05d0\u05d9\u05d4 \u05e9\u05e2\u05dc \u05d1\u05e1\u05d9\u05e1\u05d4 \u05e0\u05e7\u05d1\u05e2 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 (\u05dc\u05de\u05e9\u05dc invoice_supplier / repair_vendor_reference)"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "certain",
        "strong",
        "weak"
      ],
      "default": "strong",
      "description": "\u05e8\u05de\u05ea \u05d5\u05d3\u05d0\u05d5\u05ea \u05e7\u05d1\u05d9\u05e2\u05ea \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "source": {
      "type": "string",
      "enum": [
        "MIGRATION",
        "USER",
        "INTEGRATION",
        "SYSTEM"
      ],
      "default": "MIGRATION",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05e7\u05d1\u05d9\u05e2\u05ea \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3",
      "index": true
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d7\u05d9\u05dc\u05ea \u05ea\u05d5\u05e7\u05e3"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time",
      "description": "\u05e1\u05d5\u05e3 \u05ea\u05d5\u05e7\u05e3. \u05e8\u05d9\u05e7 = \u05e4\u05e2\u05d9\u05dc"
    },
    "correlation_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e2\u05e7\u05d1 \u05dc\u05d6\u05e8\u05d9\u05de\u05d4 \u05e9\u05d9\u05e6\u05e8\u05d4 \u05d0\u05ea \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3",
      "index": true
    },
    "migration_run_id": {
      "type": "string",
      "description": "MigrationRun \u05e9\u05d1\u05de\u05e1\u05d2\u05e8\u05ea\u05d5 \u05e0\u05d5\u05e6\u05e8 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3",
      "index": true
    }
  },
  "required": [
    "supplier_id",
    "role",
    "role_key"
  ]
}