{
  "name": "CommissionRule",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05d3\u05dc \u05d4\u05e2\u05de\u05dc\u05d5\u05ea"
    },
    "rule_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d7\u05d5\u05e7"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "PERCENT_OF_NET",
        "PER_UNIT",
        "LINE_4G",
        "LINE_5G"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d7\u05d5\u05e7"
    },
    "percentage": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05e2\u05de\u05dc\u05d4 (\u05dc\u05e1\u05d5\u05d2 PERCENT_OF_NET)"
    },
    "amount_per_unit": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05e2\u05de\u05dc\u05d4 \u05dc\u05d9\u05d7\u05d9\u05d3\u05d4 (\u05dc\u05e1\u05d5\u05d2\u05d9\u05dd PER_UNIT, LINE_4G, LINE_5G)"
    },
    "filters_json": {
      "type": "object",
      "additionalProperties": true,
      "description": "\u05e4\u05d9\u05dc\u05d8\u05e8\u05d9\u05dd \u05d2\u05de\u05d9\u05e9\u05d9\u05dd \u05e2\u05dc \u05d4\u05de\u05db\u05d9\u05e8\u05d5\u05ea (\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea, \u05de\u05e7\"\u05d8, \u05e9\u05dd \u05de\u05d5\u05e6\u05e8 \u05d5\u05db\u05d5')"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d7\u05d5\u05e7 \u05e4\u05e2\u05d9\u05dc"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05d4\u05d7\u05d5\u05e7"
    }
  },
  "required": [
    "model_id",
    "rule_name",
    "rule_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc",
            "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}