{
  "name": "ShippingProvider",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e1\u05e4\u05e7 (Velo, \u05e7\u05d0\u05e8\u05d2\u05d5, \u05de\u05e9\u05dc\u05d5\u05d7\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d9\u05dd \u05d5\u05db\u05d5')"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "velo",
        "cargo",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e1\u05e4\u05e7"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e1\u05e4\u05e7 \u05e4\u05e2\u05d9\u05dc"
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "description": "\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05e1\u05e4\u05e7 (API keys, endpoints, \u05d5\u05db\u05d5')"
    },
    "api_url": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea API \u05e9\u05dc \u05d4\u05e1\u05e4\u05e7"
    },
    "supported_carriers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d7\u05d1\u05e8\u05d5\u05ea \u05de\u05e9\u05dc\u05d5\u05d7\u05d9\u05dd \u05e0\u05ea\u05de\u05db\u05d5\u05ea"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d5\u05d4\u05e1\u05d1\u05e8\u05d9\u05dd"
    }
  },
  "required": [
    "name",
    "provider_type"
  ]
}