    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05ea\u05de\u05e9"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d7\u05d9\u05dc\u05ea \u05ea\u05e7\u05d5\u05e4\u05d4"
    },
    "period_end": {
      "type": "string",
