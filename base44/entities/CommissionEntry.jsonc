{
  "name": "CommissionEntry",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05d5\u05e8\u05ea \u05d4\u05de\u05db\u05d9\u05e8\u05d4",
      "index": true
    },
    "agent_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e0\u05e6\u05d9\u05d2",
      "index": true
    },
    "agent_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e0\u05e6\u05d9\u05d2 (\u05dc\u05e0\u05d5\u05d7\u05d5\u05ea)"
    },
    "commission_model_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05d3\u05dc \u05d4\u05e2\u05de\u05dc\u05d5\u05ea \u05e9\u05e0\u05d1\u05d7\u05e8"
    },
    "commission_rule_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d7\u05d5\u05e7 \u05d4\u05e2\u05de\u05dc\u05d4"
    },
    "rule_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d7\u05d5\u05e7 (\u05dc\u05e0\u05d5\u05d7\u05d5\u05ea)"
    },
    "rule_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d7\u05d5\u05e7"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05db\u05d9\u05e8\u05d4",
      "index": true
    },
    "base_net_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05e0\u05d8\u05d5 \u05e9\u05d4\u05d7\u05d5\u05e7 \u05d4\u05ea\u05d1\u05e1\u05e1 \u05e2\u05dc\u05d9\u05d5"
    },
    "base_quantity": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05e9\u05d4\u05d7\u05d5\u05e7 \u05d4\u05ea\u05d1\u05e1\u05e1 \u05e2\u05dc\u05d9\u05d4"
    },
    "commission_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05e2\u05de\u05dc\u05d4 \u05d1\u05e9\"\u05d7"
    },
    "calculation_period": {
      "type": "string",
      "description": "\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05d7\u05d9\u05e9\u05d5\u05d1 (YYYY-MM)",
      "index": true
    },
    "sale_details": {
      "type": "object",
      "additionalProperties": true,
      "description": "\u05e4\u05e8\u05d8\u05d9 \u05d4\u05de\u05db\u05d9\u05e8\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea (\u05dc\u05e0\u05d5\u05d7\u05d5\u05ea)"
    }
  },
  "required": [
    "sale_id",
    "agent_id",
    "commission_rule_id",
    "issue_date",
    "commission_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "\u05de\u05e0\u05d4\u05dc",
                "\u05de\u05e0\u05d4\u05dc \u05de\u05e9\u05de\u05e8\u05ea"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "\u05de\u05e0\u05d4\u05dc"
          ]
        }
      }
    }
  }
}